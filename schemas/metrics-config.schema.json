  "required": [
    "method_version",
    "window_hours",
    "dup_threshold",
    "min_story_countries",
    "bs_min_countries",
    "bs_min_own_countries",
    "bs_max_it_outlets",
    "panel_health_min",
    "grace_hours",
    "gdelt_timeout_hours",
    "location_min_share",
    "relevance_normalization",
    "excluded_categories"
