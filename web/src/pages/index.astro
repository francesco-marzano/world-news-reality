---
const title = "World News Reality";
const description =
  "Quali storie racconta il mondo e quali mancano nei media italiani. Progetto open source in costruzione.";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p>{description}</p>
      <p>
        Il sito non pubblica ancora dati. Codice, metodo e piano di lavoro sono su
        <a href="https://github.com/francesco-marzano/world-news-reality">GitHub</a>.
      </p>
    </main>
  </body>
</html>
